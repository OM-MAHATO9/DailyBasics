{
  "expo": {
    "name": "DailyBasic",
    "slug": "dailybasic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailybasic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.hyperlocalcommerce.pvyxin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#053E2B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.hyperlocalcommerce.pvyxin"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "DailyBasic",
      "shortName": "DailyBasic",
      "description": "Made for everyday",
      "themeColor": "#00452F",
      "backgroundColor": "#053E2B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#053E2B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "DailyBasic: Made for everyday"
  }
}
