# Copy to backend/.env and fill in. Never commit the real .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=dailybasics
JWT_SECRET=change-me

# Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys)
# The KEY_SECRET stays on the backend only; the app gets the KEY_ID from the API.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=any-long-random-string
